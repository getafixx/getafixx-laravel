APP_NAME=getafixx
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# SQLite needs zero setup — just run: touch database/database.sqlite
DB_CONNECTION=sqlite

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file
SESSION_DRIVER=file
FILESYSTEM_DISK=local

# Set this to a random string, then set the SAME value as the
# "X-Webhook-Secret" header on the Zapier "Webhooks by Zapier" POST
# action that calls /webhooks/soundcloud-track.
SOUNDCLOUD_WEBHOOK_SECRET=
